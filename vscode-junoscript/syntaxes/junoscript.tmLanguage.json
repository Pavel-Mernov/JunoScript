{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JunoScript",
  "scopeName": "source.junoscript",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#imports" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.junoscript",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.junoscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "meta.interpolation.junoscript",
              "begin": "(?<!\\\\)\\$\\{",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.junoscript" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.junoscript" } },
              "patterns": [{ "include": "$self" }]
            },
            {
              "name": "constant.character.escape.junoscript",
              "match": "\\\\[nrt0\\\\\"'`$]"
            }
          ]
        },
        {
          "name": "string.quoted.single.junoscript",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "meta.interpolation.junoscript",
              "begin": "(?<!\\\\)\\$\\{",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.junoscript" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.junoscript" } },
              "patterns": [{ "include": "$self" }]
            },
            {
              "name": "constant.character.escape.junoscript",
              "match": "\\\\[nrt0\\\\\"'`$]"
            }
          ]
        },
        {
          "name": "string.quoted.other.junoscript",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "meta.interpolation.junoscript",
              "begin": "(?<!\\\\)\\$\\{",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.junoscript" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.junoscript" } },
              "patterns": [{ "include": "$self" }]
            },
            {
              "name": "constant.character.escape.junoscript",
              "match": "\\\\[nrt0\\\\\"'`$]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.junoscript",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "begin": "\\b(import)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.import.junoscript" }
          },
          "end": "$",
          "patterns": [
            { "include": "#comments" },
            { "include": "#strings" },
            {
              "match": "\\b(from)\\b",
              "name": "keyword.control.import.from.junoscript"
            },
            {
              "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
              "name": "variable.other.import.junoscript"
            },
            {
              "match": "[{},]",
              "name": "punctuation.definition.import.junoscript"
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fun)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.junoscript" },
            "2": { "name": "entity.name.function.junoscript" }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.junoscript" },
            "2": { "name": "entity.name.type.junoscript" }
          }
        },
        {
          "match": "\\b(let|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.junoscript" },
            "2": { "name": "variable.other.junoscript" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.junoscript",
          "match": "\\b(if|else|for|of|while|return|in|as|from|import)\\b"
        },
        {
          "name": "storage.modifier.junoscript",
          "match": "\\b(readonly|static)\\b"
        },
        {
          "name": "storage.type.junoscript",
          "match": "\\b(let|const|fun|type)\\b"
        },
        {
          "name": "variable.language.this.junoscript",
          "match": "\\bthis\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.junoscript",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.junoscript",
          "match": "\\b(string|number|boolean|void)\\b"
        },
        {
          "name": "support.type.builtin.junoscript",
          "match": "\\b(Array|Error)\\b"
        },
        {
          "match": "\\b(isType)\\b",
          "name": "support.function.junoscript"
        },
        {
          "name": "entity.name.type.junoscript",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=<)",
          "captures": {
            "1": { "name": "entity.name.function.junoscript" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.junoscript" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.junoscript",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.comparison.junoscript",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.junoscript",
          "match": "!|&|\\|"
        },
        {
          "name": "keyword.operator.assignment.junoscript",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.junoscript",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.optional.junoscript",
          "match": "\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.junoscript",
          "match": "[,.:]"
        },
        {
          "name": "punctuation.section.junoscript",
          "match": "[\\{\\}\\(\\)\\[\\]]"
        }
      ]
    }
  }
}
