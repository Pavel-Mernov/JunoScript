import { console } from "juno"

type IterableArray = Iterable<string | number> & {
    data: (string | number)[]
    toArray(): (string | number)[] = this.data
}

const array: IterableArray = {
    data: ['0', 1, 2, 3, 'four'],
}

for const item of array
    console.log(item)

console.log(array.toArray())
type ObjectIterable = Iterable<{ id: number }> & {
    data: { id: number }[]
    toArray(): { id: number }[] = this.data
}
const objectIterable: ObjectIterable = {
    data: [{ id: 1 }],
}
console.log("iterable includes uses JN ==:", objectIterable.includes({ id: 1 }))

console.log("map:", array.map((item) => item.toString()))
const mappedObjects = array.map((item) => { value: item.toString() })
console.log("map to objects:", mappedObjects)
console.log("filter:", array.filter((item) => item != 2))
console.log("flatMap:", array.flatMap((item) => [item]))
console.log("join:", array.join(" | "))
console.log("slice:", array.slice(1, 4))
console.log("toReversed:", array.toReversed())
console.log("concat:", array.concat(['five']))
console.log("every:", array.every((item) => item != null))
# No element matches this predicate, so some() should return false.
console.log("some:", array.some((item) => item == 99))
array.forEach((item) => console.log("forEach:", item))

const numbers = [1, 2]
const words = ['three', 'four']
const spreadArray = [0, ...numbers, ...words, 5]
console.log("array spread:", spreadArray)

const iterableSpread = ['before', ...array, 'after']
console.log("iterable spread:", iterableSpread)

fun collect(...values: (string | number)[]): (string | number)[] =
    return values
console.log("argument spread:", collect(0, ...numbers, ...words, 5))
console.log("iterable argument spread:", collect(...array))

const mixedSpread = [null, ...[1, true], ...'ok', { value: 2 }]
console.log("mixed type spread:", mixedSpread)

fun collectAny(...values: any[]): any[] =
    return values
console.log("mixed argument spread:", collectAny('start', ...[1, true], ...'ok', { value: 2 }, null))
