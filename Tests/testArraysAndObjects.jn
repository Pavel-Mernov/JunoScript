import { console } from 'juno:node'
import { Range } from 'juno'

console.log("=== Array and object index tests ===")

let values = ["zero", "one", "two"]
console.log("isType<Array>(values) =", isType<Array>(values))
console.log("isType<object>(values) =", isType<object>(values))
console.log("array[0] =", values[0])
console.log("array[1] =", values[1])
console.log("array[2] =", values[2])
console.log("array.toString() =", values.toString())
console.log("primitive toString() =", 42.toString(), true.toString(), "Juno".toString())

# Arrays can contain values of different types, including objects and functions.
let mixedValues = [42, "hello", true, { name: "Ada" }, () => "called from array"]
console.log("mixed array number =", mixedValues[0])
console.log("mixed array string =", mixedValues[1])
console.log("mixed array boolean =", mixedValues[2])
console.log("mixed array object field =", mixedValues[3].as<{ name: string }>().name)
console.log("mixed array function result =", mixedValues[4].as<() => string>()())

let person =
    {
        name: "Pasha"
        age: 30
        greet() =
            return "Hello, " + this.name
    }

console.log("isType<object>(person) =", isType<object>(person))
console.log("isType<Array>(person) =", isType<Array>(person))
console.log("person.name =", person.name)
console.log("person['name'] =", person["name"])
console.log("person[1] =", person[1])
console.log("person.greet() =", person.greet())
console.log("person.toString() =", person.toString())
console.log("person in a template = ${person}")
console.log("person sent to console =", person)

let namedObject = {
    name: "Ada"
    toString() =
        return "Person: " + this.name
}
console.log("custom toString() =", namedObject.toString())
console.log("custom object in a template = ${namedObject}")
console.log("custom object sent to console =", namedObject)

type PlainPerson = {
    name: string
}
let typedPerson: PlainPerson = { name: "Grace" }
console.log("typed object default toString() =", typedPerson.toString())

type HasName = {
    name: string
}
let extendedPerson = { name: "Ada", role: "admin", employeeId: 42 }
let personView = extendedPerson.as<HasName>()
console.log("as<T>() retains extra fields =", personView.toString())
console.log("as<T>() on a number =", 42.as<number>())
console.log("as<T>() on a string =", "Juno".as<string>())
console.log("as<T>() on an array =", [1, 2, 3].as<number[]>().toString())

const extendedInfo = {
    ...typedPerson,
    surname : 'Sullivan'
}

console.log('ExtendedInfo:', extendedInfo)

# Each invalid-index case should stop execution with TypeError.
# Uncomment one case at a time to inspect the error.
# values[-1]
# values[3]
# values[1.5]
# person[true]

type Getter = {
    get value(): string = 
        return "Hello, world!"
    set value(value: string) =
        console.log("value set to", value)
}

let getter = Getter()
console.log("getter.value =", getter.value)
getter.value = "Hello, world!"

const range = Range(5)
console.log("Range fields =", range.start, range.end, range.step)
console.log("Range values =", range.toArray())

console.log("=== Array and object index tests complete ===")
