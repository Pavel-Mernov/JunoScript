import { Array, Range, Tuple } from 'juno:types'
import { console, Math } from 'juno'

console.log("=== Array and object index tests ===")

let values = ["zero", "one", "two"]
console.log("isType<Array>(values) =", isType<Array>(values))
console.log("isType<object>(values) =", isType<object>(values))
console.log("array[0] =", values[0])
console.log("array[1] =", values[1])
console.log("array[2] =", values[2])
console.log("array.toString() =", values.toString())
console.log("array includes uses JN ==:", [{ id: 1 }].includes({ id: 1 }))
console.log("array includes NaN and signed zero:", [Math.NaN].includes(Math.NaN), [-0].includes(0))
console.log("primitive toString() =", 42.toString(), true.toString(), "Juno".toString())

# Arrays can contain values of different types, including objects and functions.
let mixedValues = [42, "hello", true, { name: "Ada" }, () => "called from array"]
console.log("mixed array number =", mixedValues[0])
console.log("mixed array string =", mixedValues[1])
console.log("mixed array boolean =", mixedValues[2])
console.log("mixed array object field =", mixedValues[3].as<{ name: string }>().name)
console.log("mixed array function result =", mixedValues[4].as<() => string>()())

let person =
    {
        name: "Pasha"
        age: 30
        greet() =
            return "Hello, " + this.name
    }

console.log("isType<object>(person) =", isType<object>(person))
console.log("isType<Array>(person) =", isType<Array>(person))
console.log("person.name =", person.name)
console.log("person['name'] =", person["name"])
# console.log("person[1] =", person[1])
console.log("person.greet() =", person.greet())
console.log("person.toString() =", person.toString())
console.log("person in a template = ${person}")
console.log("person sent to console =", person)

let namedObject = {
    name: "Ada"
    toString() =
        return "Person: " + this.name
}
console.log("custom toString() =", namedObject.toString())
console.log("custom object in a template = ${namedObject}")
console.log("custom object sent to console =", namedObject)

type PlainPerson = {
    name: string
}
let typedPerson: PlainPerson = { name: "Grace" }
console.log("typed object default toString() =", typedPerson.toString())

type HasName = {
    name: string
}
let extendedPerson = { name: "Ada", role: "admin", employeeId: 42 }
let personView = extendedPerson.as<HasName>()
console.log("as<T>() retains extra fields =", personView.toString())
console.log("as<T>() on a number =", 42.as<number>())
console.log("as<T>() on a string =", "Juno".as<string>())
console.log("as<T>() on an array =", [1, 2, 3].as<number[]>().toString())

const extendedInfo = {
    ...typedPerson,
    surname : 'Sullivan'
}

console.log('ExtendedInfo:', extendedInfo)

# Each invalid-index case should stop execution with TypeError.
# Uncomment one case at a time to inspect the error.
# values[-1]
# values[3]
# values[1.5]
# person[true]

type Getter = {
    get value(): string = 
        return "Hello, world!"
    set value(value: string) =
        console.log("value set to", value)
}

let getter = Getter()
console.log("getter.value =", getter.value)
getter.value = "Hello, world!"

const range = Range(5)
console.log("Range fields =", range.start, range.end, range.step)
console.log("Range values =", range.toArray())



const array = Array<number>(3, { fill: (element, index) => index })
console.log('initial', array.toArray())
console.log('copy', array.copy())
console.log('push length', array.push(3, 4), array.toArray())
console.log('pop', array.pop(), array.toArray())
console.log('shift', array.shift(), array.toArray())
console.log('unshift length', array.unshift(-1, 0), array.toArray())
console.log('reverse', array.reverse().toArray())
console.log('fill', array.fill(9, 1, 3).toArray())
console.log('copyWithin', array.copyWithin(0, 2, 4).toArray())
console.log('splice', array.splice(1, 2, 7, 8), array.toArray())
console.log('sort', array.sort((left, right) => left - right).toArray())
console.log('enumerate', array.enumerate())
const enumerated = array.enumerate()
const [firstEntry] = enumerated
const [entryIndex, entryValue] = firstEntry
console.log('enumerate tuple types', entryIndex, entryValue)

const fromNumbers = Array.from([10, 20, 30])
const fromStrings = Array.from(['a', 'b', 'c'])
const fromString = Array.from('abc_str')
const fromMapped = Array.from([10, 20, 30], (value, index) => value + index)
const fromWithThisArg = Array.from([1, 2], (value, index) => value + index, { label: 'context' })
const ofNumbers = Array.of(4, 5, 6)
console.log('Array.from numbers', fromNumbers.toArray())
console.log('Array.from strings', fromStrings.toArray())
console.log('Array.from one string', fromString.toArray())
console.log('Array.from mapped', fromMapped.toArray())
console.log('Array.from thisArg', fromWithThisArg.toArray())
console.log('Array.of numbers', ofNumbers.toArray())

type Functional = {
    fun (arg : string | number) =
        "Anonymous method. param: ${this.param}. arg: ${arg}."
    readonly prop = "prop"
    readonly param : string | number
}

const funcObject = {
    field : 'something...',
    fun (arg : string | number) =
        return 'func object. field:${this.field}. arg:${arg}'
}

type FunctionPrototype = {
    fun (arg : string | number): string
    fun describe(arg : string): string
}

const typedFunc = Functional({ param: "typed" })
const prototypeFunc : FunctionPrototype = {
    fun (arg : string | number) =
        return "prototype call. arg:${arg}"
    fun describe(arg : string) =
        return "prototype method. arg:${arg}"
}

console.log(typedFunc)
console.log(funcObject)
console.log(prototypeFunc)
console.log(typedFunc("argument"))
console.log(funcObject(42))
console.log(prototypeFunc("anonymous"))
console.log(prototypeFunc.describe("named"))

const callableContext = { field: "call context" }
const boundFuncObject = funcObject.bind(callableContext)
console.log(funcObject.call(callableContext, "call"))
console.log(funcObject.apply(callableContext, ["apply"]))
console.log(boundFuncObject("bind"))

const overriddenCallable = {
    fun (arg : string) =
        return "anonymous:${arg}"
    fun call(thisArg : any, arg : string) =
        return "overridden call:${arg}"
    fun apply(thisArg : any, args : any[]) =
        return "overridden apply:${args[0]}"
    fun bind(thisArg : any) =
        return "overridden bind"
}

console.log(overriddenCallable.call(null, "value"))
console.log(overriddenCallable.apply(null, ["value"]))
console.log(overriddenCallable.bind(null))

fun invokeCallback(callback : (string | number) -> string, arg : string | number): string =
    return callback(arg)

const assignedCallable : (string | number) -> string = funcObject
console.log(assignedCallable("assigned"))
console.log(invokeCallback(funcObject, "argument"))

fun regularCallback(arg : string | number): string =
    return "regular callback:${arg}"

fun callTwice(callback : (string | number) -> string, first : string | number, second : string | number): string[] =
    return [callback(first), callback(second)]

fun callbackFactory(callback : (string | number) -> string): (string | number) -> string =
    return callback

const returnedFunction = callbackFactory(regularCallback)
const returnedCallable = callbackFactory(funcObject)
console.log(callTwice(regularCallback, "first", 2))
console.log(callTwice(funcObject, "first", 2))
console.log(returnedFunction("returned function"))
console.log(returnedCallable("returned callable"))

fun addNumbers(left : number, right : number): number =
    return left + right

const callableAdder = {
    offset: 10,
    fun (left : number, right : number): number =
        return this.offset + left + right
}

fun calculate(callback : (number, number) -> number, left : number, right : number): number =
    return callback(left, right)

console.log(calculate(addNumbers, 3, 4))
console.log(calculate(callableAdder, 3, 4))

const defaultBooleanObject = { value: 1 }
const overriddenBooleanObject = {
    value: 0,
    fun toBoolean(): boolean =
        return this.value > 0
}
console.log("default object boolean:", !!defaultBooleanObject, defaultBooleanObject ? "truthy" : "falsy")
console.log("overridden object boolean:", !!overriddenBooleanObject, overriddenBooleanObject ? "truthy" : "falsy")

const pickSource = { name: "Ada", age: 36, language: "Juno" }
const pickedObject = pickSource.pick("name", "age")
const omittedObject = pickSource.omit("age")
console.log("object pick:", pickedObject.name, pickedObject.age, pickedObject.has("language"))
console.log("object omit:", omittedObject.name, omittedObject.language, omittedObject.has("age"))

const pickArraySource = [10, 20, 30, 40]
const pickedArray = pickArraySource.pick(0, 2)
const omittedArray = pickArraySource.omit(1, 3)
console.log("array pick:", pickedArray)
console.log("array omit:", omittedArray)

console.log("=== Readonly and mutable copy tests ===")

const readonlyArrayCopy = [1, 2, 3].asReadonly()
const mutableArrayCopy = readonlyArrayCopy.asMutable()
mutableArrayCopy.push(4)
console.log("readonly array copy:", readonlyArrayCopy)
console.log("mutable array copy:", mutableArrayCopy)

const readonlyObjectCopy = { name: "Ada", age: 36 }.asReadonly()
const mutableObjectCopy = readonlyObjectCopy.asMutable()
mutableObjectCopy.name = "Grace"
mutableObjectCopy.age = 37
console.log("readonly object copy:", readonlyObjectCopy)
console.log("mutable object copy:", mutableObjectCopy)

const deepSource = { nested: { value: 1 }, items: [1, 2] }
const deepClone = deepSource.deepClone()
deepClone.nested.value = 2
deepClone.items.push(3)
console.log("deep clone source unchanged:", deepSource.nested.value, deepSource.items.length)
console.log("deep clone changed independently:", deepClone.nested.value, deepClone.items.length)

const deeplyFrozen = deepSource.deepFreeze()
console.log("deep freeze values:", deeplyFrozen.nested.value, deeplyFrozen.items.length)
# deeplyFrozen.nested.value = 2
# deeplyFrozen.items.push(3)

const frozenCopy = deepSource.toDeepFreezed()
console.log("deep frozen copy:", frozenCopy.nested.value, frozenCopy.items.length)
# frozenCopy.nested.value = 2
# frozenCopy.items.push(3)

const typedTuple = Tuple("first", 2, true)
const tupleString = typedTuple[0]
const tupleNumber = typedTuple[1]
const tupleBoolean = typedTuple[2]
console.log("typed readonly tuple:", tupleString, tupleNumber, tupleBoolean, typedTuple.length)

const [arrayFirst, , arrayThird, ...arrayRest] = [10, 20, 30, 40, 50]
console.log("array destructuring:", arrayFirst, arrayThird, arrayRest)

let [mutableFirst, ...mutableRest] = [1, 2, 3]
mutableFirst = 10
mutableRest.push(4)
console.log("mutable array destructuring:", mutableFirst, mutableRest)

const [destructuredText, destructuredNumber,] = typedTuple
const [_, ...tupleRest] = typedTuple
console.log("tuple destructuring:", destructuredText, destructuredNumber, tupleRest)

