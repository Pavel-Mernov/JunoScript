import {
    answer,
    first,
    second,
    greet,
    Greeting,
    fromCharCode,
    fromCodePoint
} from './testExports'
import { Error, Result, ok } from 'juno:types'
import { console } from 'juno:node'

const message: string = greet('Juno')
const greeting: Greeting = { text: message }
const known: Error = Error(message)
const checked: Error = known
const success: Result<string> = ok(message)
const failure: Result<null, Error> = Error.result(known)

const text = message

const greeting2 = Greeting({ text })

console.log('imported value:', answer)
console.log('destructured exports:', first, second)
console.log('imported function:', text)
console.log('imported type:', greeting)
console.log('imported Result helpers:', success, failure)
console.log('type constructor:', greeting2)
console.log('TypeScript re-export:', fromCharCode(65, 66, 67), fromCodePoint(128512))
