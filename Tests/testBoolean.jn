import { console } from 'juno:node'
import { Math, Boolean } from 'juno'

const ready = true
const hasName = false

const status = ready ? "ready" : "waiting"
const alternateStatus = hasName ? "named" : "anonymous"
console.log("ternary:", status, alternateStatus)

let optionalName: string? = null
let displayName = optionalName ?? "Guest"
console.log("nullish:", displayName)
let providedName: string? = "Pasha"
let chosenName = providedName ?? "Guest"
console.log("nullish with a value:", chosenName)

if !hasName
    console.log("not hasName")

if ready & !hasName
    console.log("AND condition")

if hasName | ready
    console.log("OR condition")

if ready & (hasName | !hasName)
    console.log("combined condition")

const number = ready ? 42 : 0
const fallbackNumber = optionalName == null ? 7 : 8
console.log("ternary values:", number, fallbackNumber)

const defaultTruthyObject = { label: 'default' }
const customFalsyObject = {
    fun toBoolean(): boolean =
        return false
}
const customTruthyObject = {
    fun toBoolean(): boolean =
        return true
}

console.log("object !!:", !!defaultTruthyObject, !!customFalsyObject, !!customTruthyObject)
console.log("object ternary:", defaultTruthyObject ? 'true' : 'false', customFalsyObject ? 'true' : 'false')
if customFalsyObject
    console.log("custom falsy object branch must not run")
else
    console.log("custom falsy object condition: false")

console.log("Boolean numbers:", Boolean(0), Boolean(-0), Boolean(1), Boolean(-1), Boolean(Math.NaN), Boolean(Math.Infinity))
console.log("Boolean BigInt:", Boolean(0n), Boolean(1n), Boolean(-1n))
console.log("Boolean strings:", Boolean(''), Boolean('0'), Boolean('false'), Boolean('Juno'))
console.log("Boolean null and booleans:", Boolean(null), Boolean(false), Boolean(true))
console.log("Boolean collections:", Boolean([]), Boolean([0]), Boolean({}), Boolean({ value: 0 }))
console.log("Boolean custom objects:", Boolean(customFalsyObject), Boolean(customTruthyObject), Boolean(defaultTruthyObject))
