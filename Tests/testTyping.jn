const bigint1 = 1n

type Person = {
    name: string
    surname: string?
    age: number
    greet() =
        return "Hello, " + this.name + " " + (this.surname ?? '')
}

const paul : Person = {
    name : 'Paul',
    surname : 'Mernov',
    age : 23
}

const maria : Person? = {
    age: 22,
    name : 'Maria'
}

let peter : Person?

console.log(maria?.surname)
console.log(paul.greet())
console.log(maria?.greet())

console.log(peter?.surname)
console.log(peter?.greet())

type Address = {
    id : string | number
}
