import { console } from 'juno:node'
import {
    createProfile,
    formatValue,
    scaleNumbers,
    label,
    version,
    runtime,
    interop
} from './reexports.jn'

const profile = createProfile('Grace', [7, 8])

console.log('re-exported TS:', label, version, formatValue(profile.name), scaleNumbers(profile.scores, 3))
console.log('destructured Juno export:', runtime, interop)
