import { outputFor } from './output.cjs'

const checkOutput = outputFor('testMath.jn')
import { Math, Number } from 'juno'
import { Random } from 'juno:types'
import { random } from '../../types/random.ts'

const math = Math

checkOutput("=== Math library tests ===")

# Constants
checkOutput("constants:", math.PI, math.E, math.SQRT2, math.LN2)

# Rounding and absolute value
checkOutput("abs / sign:", math.abs(-7), math.sign(-7), math.sign(0), math.sign(7))
checkOutput("ceil / floor / round / trunc:", math.ceil(2.3), math.floor(2.8), math.round(2.5), math.trunc(-2.8))

# Min, max, powers, and roots
checkOutput("min / max:", math.min(4, -2, 9), math.max(4, -2, 9))
checkOutput("pow / sqrt / cbrt / hypot:", math.pow(3, 2), math.sqrt(81), math.cbrt(27), math.hypot(3, 4))

# Exponential and logarithmic functions
checkOutput("exp / log:", math.exp(1), math.log(math.E))
checkOutput("log2 / log10:", math.log2(8), math.log10(1000))

# Trigonometric functions (angles are in radians)
checkOutput("sin / cos / tan:", math.sin(0), math.cos(0), math.tan(0))
checkOutput("asin / acos / atan / atan2:", math.asin(0), math.acos(1), math.atan(0), math.atan2(0, 1))

# Hyperbolic functions
checkOutput("sinh / cosh / tanh:", math.sinh(0), math.cosh(0), math.tanh(0))

# Integer and floating-point helpers
checkOutput("clz32 / imul:", math.clz32(1), math.imul(6, 7))
checkOutput("fround:", math.fround(1.337))

# random() should return a value in [0, 1).
const randomValue = math.random()
checkOutput("random in [0, 1):", randomValue >= 0 & randomValue < 1)
const importedRandomValue: number = random()
checkOutput("imported random in [0, 1):", importedRandomValue >= 0 & importedRandomValue < 1)

const randomDefault = Random.next()
const randomToTen = Random.next(10)
const randomRange = Random.next(-5, 5)
const randomReverseRange = Random.next(5, -5)
const randomInteger = Random.nextInt(2, 6)
const randomReverseInteger = Random.nextInt(6, 2)
checkOutput("Random.next() in [0, 1):", randomDefault >= 0 & randomDefault < 1)
checkOutput("Random.next(10) in [0, 10):", randomToTen >= 0 & randomToTen < 10)
checkOutput("Random.next(-5, 5) in [-5, 5):", randomRange >= -5 & randomRange < 5)
checkOutput("Random.next(5, -5) in [-5, 5):", randomReverseRange >= -5 & randomReverseRange < 5)
checkOutput("Random.nextInt(2, 6) integer in [2, 6):", Number.isInteger(randomInteger) & randomInteger >= 2 & randomInteger < 6)
checkOutput("Random.nextInt(6, 2) integer in [2, 6):", Number.isInteger(randomReverseInteger) & randomReverseInteger >= 2 & randomReverseInteger < 6)

checkOutput("=== Math library tests complete ===")
