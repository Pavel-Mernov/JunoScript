import { outputFor } from './output.cjs'

const recordOutput = outputFor('testRegEx.jn')
const checkOutput = <TArgs is any[]>(...args: TArgs) => recordOutput(...args)

const literal: RegEx = /<...>/
const constructed: RegEx = RegEx('<...>')
const flagged: RegEx = /hello/gi

checkOutput(literal.test('<abc>'))
checkOutput(constructed.test('<xyz>'))
checkOutput(flagged.test('Hello'))
checkOutput(12 / 3)
