import { outputFor } from '../../output.cjs'

const recordOutput = outputFor('testBuild/testBuildOutput/testBuildLoop.jn')
const checkOutput = <TArgs is any[]>(...args: TArgs) => recordOutput(...args)
import { Range } from 'juno:types'

for const num of Range(3)
    checkOutput(num)

['name', 23, 'age', 'Paul'].forEach(elem => checkOutput(elem))
