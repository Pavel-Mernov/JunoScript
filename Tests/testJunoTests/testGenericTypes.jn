import { outputFor } from './output.cjs'

const checkOutput = outputFor('testGenericTypes.jn')
import { Partial, Pick, Omit} from 'juno:types'

type User = {
    name: string
    age: number
    active: boolean
}

type PartialUser = Partial<User>
const partialUser : PartialUser = { name: "Ada" }
checkOutput("Partial<User> accepts missing fields =", isType<PartialUser>(partialUser))

type NamedUser = Pick<User, "name">
const namedUser : NamedUser = { name: "Grace", extra: "preserved" }
checkOutput("Pick<User, name> accepts extra fields =", isType<NamedUser>(namedUser))
checkOutput("Pick leaves extra fields on the object =", namedUser.toString())

type UserWithoutAge = Omit<User, "age">
const activeUser : UserWithoutAge = { name: "Lin", active: true }
checkOutput("Omit<User, age> accepts the remaining shape =", isType<UserWithoutAge>(activeUser))
