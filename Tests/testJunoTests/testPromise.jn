import { outputFor } from './output.cjs'

const recordOutput = outputFor('testPromise.jn')
const checkOutput = <TArgs is any[]>(...args: TArgs) => recordOutput(...args)
import { Promise, setTimeout, clearTimeout } from 'juno:async'

checkOutput('sync: before promise')

const cancelled = setTimeout(() => checkOutput('timeout: cancelled callback must not run'), 25)
clearTimeout(cancelled)

fun delayed(value: number, delay: number): number =
    return await Promise<number>((resolve) =>
        setTimeout(() => resolve(value), delay)
    )

const chain = Promise.resolve(2)
    .then(value => value + 3).
    then((value) => 
        return delayed(value * 2, 5)
    )
    .then((value) => Promise.resolve({
        ok: false,
        error: `chain failed after ${value}`
    }))
    .catch((error) => 20)
    .then((value) => value + 1)

chain.then((value) => 
    checkOutput('promise chain result:', value)
    )

setTimeout(() => checkOutput('timeout: completed'), 10)
checkOutput('sync: after promise')
