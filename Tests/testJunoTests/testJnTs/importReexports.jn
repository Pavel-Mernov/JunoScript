import { outputFor } from '../output.cjs'

const checkOutput = outputFor('testJnTs/importReexports.jn')
import {
    createProfile,
    formatValue,
    scaleNumbers,
    label,
    version,
    runtime,
    interop
} from './reexports.jn'

const profile = createProfile('Grace', [7, 8])

checkOutput('re-exported TS:', label, version, formatValue(profile.name), scaleNumbers(profile.scores, 3))
checkOutput('destructured Juno export:', runtime, interop)
